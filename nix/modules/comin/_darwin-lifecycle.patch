+package executor
+
+import (
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestCominPlistHash(t *testing.T) {
+	filename := t.TempDir() + "/comin.plist"
+	assert.Empty(t, cominPlistHash(filename))
+	assert.NoError(t, os.WriteFile(filename, []byte("old configuration"), 0600))
+	previous := cominPlistHash(filename)
+	assert.NotEmpty(t, previous)
+	assert.Equal(t, previous, cominPlistHash(filename))
+	assert.NoError(t, os.WriteFile(filename, []byte("new configuration"), 0600))
+	assert.NotEqual(t, previous, cominPlistHash(filename))
+}
+
+func TestDarwinActivationPreservesComin(t *testing.T) {
+	directory := t.TempDir()
+	assert.NoError(t, os.WriteFile(directory+"/activate-user", []byte("#!/bin/sh\nexit 0\n"), 0700))
+	assert.NoError(t, os.WriteFile(directory+"/activate", []byte("#!/bin/sh\nprintf '%s' \"$1\" > \"$0.args\"\n"), 0700))
+	output, err := os.Create(directory + "/output")
+	if !assert.NoError(t, err) {
+		return
+	}
+	defer output.Close()
+	assert.NoError(t, switchToConfigurationDarwin("switch", directory, false, output, output))
+	arguments, err := os.ReadFile(directory + "/activate.args")
+	assert.NoError(t, err)
+	assert.Equal(t, "--comin", string(arguments))
+}
