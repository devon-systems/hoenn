{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "timezone": "America/New_York",
  "platformAutomerge": true,

  "nix": {
    "enabled": true
  },

  "kubernetes": {
    "managerFilePatterns": ["/k8s/.+\\.ya?ml$/"]
  },

  "flux": {
    "managerFilePatterns": ["/k8s/.+\\.ya?ml$/"]
  },

  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 4am"]
  },

  "packageRules": [
    {
      "description": "OCI Helm charts use chart versions, not container digests",
      "matchManagers": ["flux"],
      "pinDigests": false
    },
    {
      "description": "Auto-merge routine updates after CI passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Major bumps stay manual",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Lock file maintenance updates FlakeHub inputs",
      "matchManagers": ["nix"],
      "matchPackageNames": ["/^https:\\/\\/flakehub\\.com\\/f\\//"],
      "enabled": false
    },
    {
      "description": "Let the Flux manager update the bundle instead of individual controller images",
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["k8s/flux-system/gotk-components.yaml"],
      "enabled": false
    }
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
